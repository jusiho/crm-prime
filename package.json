{
  "name": "trimmo",
  "version": "0.0.0",
  "description": "CRM para WhatsApp con agentes de IA: bandeja multi-numero en tiempo real, bots copilot/autopilot, flujos visuales, pipeline y campanas.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jusiho/trimmo.git"
  },
  "bugs": {
    "url": "https://github.com/jusiho/trimmo/issues"
  },
  "homepage": "https://github.com/jusiho/trimmo#readme",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run db:generate -w @crm/api",
    "db:migrate": "npm run db:migrate -w @crm/api",
    "db:seed": "npm run db:seed -w @crm/api",
    "tunnel": "cloudflared tunnel --url http://localhost:3001",
    "demo": "docker compose -f docker-compose.demo.yml up --build"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2"
}
